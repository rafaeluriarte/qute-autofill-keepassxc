def fifo_send(*lines: str) -> None:
    """Append one or more qutebrowser command lines to $QUTE_FIFO.

    Each line is executed as a separate qutebrowser command (the FIFO reader
    in qutebrowser splits strictly on newlines), so any string argument that
    might contain spaces must already be quoted with qb_quote().
    """
    text = "".join(line + "\n" for line in lines)
    if not FIFO_PATH:
        # Not running as a real userscript (e.g. invoked by hand while
        # developing) -- fall back to stderr so nothing is silently lost.
        sys.stderr.write(text)
        return
    with open(FIFO_PATH, "a", encoding="utf-8") as fifo:
        fifo.write(text)


def qb_quote(text: str) -> str:
    """Quote a string as a single argument for qutebrowser's command parser.

    qutebrowser's FIFO/command-line lexer (qutebrowser.misc.split) is a fork
    of Python's shlex: inside double quotes, backslash escapes both `\\` and
    `"`, which is exactly what this produces.
    """
    escaped = text.replace("\\", "\\\\").replace('"', '\\"')
    return '"' + escaped + '"'


def message_info(text: str) -> None:
    fifo_send("message-info " + qb_quote(text))


def message_error(text: str) -> None:
    fifo_send("message-error " + qb_quote(text))


def ensure_profiles_file() -> bool:
    """Create the autofill dir + template profiles.toml if missing.

    Returns True if the template was just created (caller should stop: there
    is nothing real to fill in yet).
    """
    created = False
    AUTOFILL_DIR.mkdir(parents=True, exist_ok=True)
    os.chmod(AUTOFILL_DIR, stat.S_IRWXU)  # 700, enforced every run
    if not PROFILES_PATH.exists():
        PROFILES_PATH.write_text(TEMPLATE, encoding="utf-8")
        created = True
    if PROFILES_PATH.exists():
        os.chmod(PROFILES_PATH, stat.S_IRUSR | stat.S_IWUSR)  # 600, enforced every run
    return created


def load_profiles() -> dict:
    with open(PROFILES_PATH, "rb") as f:
        return tomllib.load(f)


def json_safe(value):
    if isinstance(value, (datetime.date, datetime.datetime)):
        return value.isoformat()
    return value


def choose_profile_with_rofi(names: list[str]) -> str | None:
    try:
        proc = subprocess.run(
            ["rofi", "-dmenu", "-p", "autofill profile"],
            input="\n".join(names) + "\n",
            capture_output=True,
            text=True,
            check=False,
        )
    except FileNotFoundError:
        message_error("autofill: rofi is not installed")
        return None
    if proc.returncode != 0:
        return None  # user cancelled (Escape)
    selection = proc.stdout.strip()
    return selection or None


def resolve_host() -> str:
    """The lowercased hostname of the current page, from $QUTE_URL."""
    url = os.environ.get("QUTE_URL", "")
    try:
        return (urlparse(url).hostname or "").lower()
    except ValueError:
        return ""


def host_candidates(host: str) -> list[str]:
    """`host` and each of its parent domains, most specific first.

    e.g. "checkout.amazon.it" -> ["checkout.amazon.it", "amazon.it", "it"]
    """
    host = (host or "").lower().strip(".")
    if not host:
        return []
    parts = host.split(".")
    return [".".join(parts[i:]) for i in range(len(parts))]


def resolve_site_settings(host: str, sites: dict) -> dict:
    """The most specific `[sites.*]` entry (from profiles.toml) matching `host`.

    `sites` is `data.get("sites", {})`, keyed by hostname -- an exact host
    ("checkout.amazon.it") or any parent domain ("amazon.it", matching
    "checkout.amazon.it" too when there is no more specific entry). Returns
    {} when nothing matches, so callers can always do
    `site.get("profile")` / `site.get("overwrite")` / `site.get("skip", [])`
    without checking for None first.
    """
    if not host or not sites:
        return {}
    lowered = {str(k).lower(): v for k, v in sites.items()}
    for candidate in host_candidates(host):
        if candidate in lowered and isinstance(lowered[candidate], dict):
            return lowered[candidate]
    return {}


def build_undo_invocation() -> str:
    """The single jseval snippet for `autofill --undo`.

    Deliberately just ONE `:jseval --world jseval` call -- no `--file` reload
    of autofill.js first. Reloading first would itself be destructive: it
    redefines the isolated world's QuteAutofill global from scratch, which
    would wipe out exactly the fill history we're trying to undo (see the
    module docstring on why the isolated `jseval` world persists that global
    across calls). Instead this snippet tolerates a fresh/undefined global
    inline, in JS, and reports "nothing to undo" rather than erroring --
    covering both "autofill was never run this page load" and "QuteAutofill
    is simply undefined because the world was reset" identically.
    """
    return (
        "(function(){"
        "if (typeof QuteAutofill === 'undefined' || !QuteAutofill.undo) "
        "{return 'autofill: nothing to undo';} "
        "try{return QuteAutofill.undo().summary;}"
        "catch(e){return 'autofill error: '+(e&&e.message?e.message:String(e));}"
        "})()"
    )


def spawn_miss_classifier(host: str) -> None:
    """Best-effort, fully detached background job: re-run the SAME
    classifier (autofill.js, via autofill-lib/run-classify.js + jsdom) over
    a dump of the current page and append anything it could not classify to
    misses.jsonl, to help improve the keyword tables later. See the module
    docstring section "Learn from misses" -- never sends field VALUES
    anywhere, only structural metadata (type/name/id/placeholder/
    autocomplete/truncated label text).

    Degrades completely silently (no message to the user, ever) if node or
    jsdom aren't available, or if anything else about this goes wrong: this
    is a nice-to-have, and must never make the actual fill look like it
    failed.
    """
    html_src = os.environ.get("QUTE_HTML")
    if not html_src:
        return
    node_bin = shutil.which("node")
    if not node_bin or not MISS_RUNNER_PATH.exists():
        return

    try:
        MISSES_DIR.mkdir(parents=True, exist_ok=True)
        os.chmod(MISSES_DIR, stat.S_IRWXU)  # 700, enforced every run
        if not MISSES_PATH.exists():
            MISSES_PATH.touch()
        os.chmod(MISSES_PATH, stat.S_IRUSR | stat.S_IWUSR)  # 600, enforced every run
    except OSError:
        return

    # $QUTE_HTML points at a temp file qutebrowser deletes the instant THIS
    # process exits (see qutebrowser/commands/userscripts.py: _cleanup() is
    # wired to the GUIProcess `finished` signal for the very process running
    # this script) -- a real race against a detached background reader that
    # is still starting up. So make our OWN private copy synchronously,
    # right here, before main() returns; the background job reads (and
    # deletes) that copy, never the original, so the race never matters.
    # Fallback cleanup: remove DOM-dump copies a crashed/killed runner left behind.
    for stale in MISSES_DIR.glob(".dom-*.html"):
        try:
            if time.time() - stale.stat().st_mtime > 600:
                stale.unlink()
        except OSError:
            pass
    try:
        with tempfile.NamedTemporaryFile(
            mode="w", encoding="utf-8", suffix=".html",
            dir=str(MISSES_DIR), prefix=".dom-", delete=False,
        ) as tmp:
            with open(html_src, "r", encoding="utf-8", errors="replace") as src:
                shutil.copyfileobj(src, tmp)
            html_copy = tmp.name
        os.chmod(html_copy, stat.S_IRUSR | stat.S_IWUSR)
    except OSError:
        return

    date_str = datetime.date.today().isoformat()
    try:
        subprocess.Popen(
            [node_bin, str(MISS_RUNNER_PATH), html_copy, host, str(MISSES_PATH), date_str],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except OSError:
        try:
            os.remove(html_copy)
        except OSError:
            pass


def normalize_label(text: str) -> str:
    text = text or ""
    text = unicodedata.normalize("NFKD", text)
    text = "".join(c for c in text if not unicodedata.combining(c))
    text = text.lower().strip()
    return re.sub(r"\s+", " ", text)


def build_misses_report(records: list) -> str:
    """A human-readable report grouping misses.jsonl by normalized label
    text, most frequent first -- exactly what `autofill --misses` writes."""
    groups: dict = {}
    no_label = {"count": 0, "hosts": set()}
    for rec in records:
        if not isinstance(rec, dict):
            continue
        label = str(rec.get("label_text") or "").strip()
        host = str(rec.get("host") or "") or "(unknown host)"
        if not label:
            no_label["count"] += 1
            no_label["hosts"].add(host)
            continue
        key = normalize_label(label)
        group = groups.setdefault(key, {"count": 0, "raw": label, "hosts": set()})
        group["count"] += 1
        group["hosts"].add(host)

    lines = [
        "autofill misses report",
        f"generated: {datetime.datetime.now().isoformat(timespec='seconds')}",
        f"total records: {len(records)}, unique labels: {len(groups)}",
        "",
    ]
    ranked = sorted(groups.items(), key=lambda kv: (-kv[1]["count"], kv[1]["raw"]))
    for _key, group in ranked:
        hosts = ", ".join(sorted(group["hosts"]))
        lines.append(f"{group['count']:4d}x  \"{group['raw']}\"  hosts: {hosts}")
    if no_label["count"]:
        hosts = ", ".join(sorted(no_label["hosts"]))
        lines.append(f"{no_label['count']:4d}x  (no label text)  hosts: {hosts}")
    if not records:
        lines.append("(no unclassified fields recorded yet -- nothing to report)")
    return "\n".join(lines) + "\n"


def handle_misses_report() -> int:
    records = []
    if MISSES_PATH.exists():
        with open(MISSES_PATH, "r", encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    records.append(json.loads(line))
                except json.JSONDecodeError:
                    continue

    report_text = build_misses_report(records)
    report_path = MISSES_DIR / "misses-report.txt"
    try:
        MISSES_DIR.mkdir(parents=True, exist_ok=True)
        os.chmod(MISSES_DIR, stat.S_IRWXU)  # 700
        report_path.write_text(report_text, encoding="utf-8")
        os.chmod(report_path, stat.S_IRUSR | stat.S_IWUSR)  # 600
    except OSError as e:
        message_error(f"autofill: could not write misses report: {e}")
        return 1

    fifo_send(f"open -t file://{quote(str(report_path))}")
    return 0


def _dump_one_line(obj) -> str:
    """JSON-encode `obj` for direct embedding in a single jseval FIFO line.

    json.dumps() always backslash-escapes control characters (including
    newline/carriage-return), so the result can never itself contain a raw
    '\\n' -- which matters here because qutebrowser's FIFO reader executes
    one command per physical line. \\u2028/\\u2029 are valid JSON but are
    additionally escaped here defensively (older/non-module JS engines
    historically treated them as line terminators inside string literals;
    QtWebEngine's current V8 no longer requires this, but it costs nothing).
    """
    text = json.dumps(obj, ensure_ascii=False)
    text = text.replace("\u2028", "\\u2028").replace("\u2029", "\\u2029")
    if "\n" in text or "\r" in text:
        # Should be unreachable given json.dumps' escaping; fail loudly
        # rather than silently emit a broken multi-line FIFO command.
        raise RuntimeError("internal error: JSON payload contained a raw newline")
    return text


def build_invocation(profile: dict, opts: dict) -> str:
    """Build the single-line JS snippet that runs QuteAutofill and returns
    the summary string qutebrowser will show via message.info()."""
    return (
        "(function(){try{var res=QuteAutofill.run("
        + _dump_one_line(profile) + "," + _dump_one_line(opts) +
        ");return res.summary;}catch(e){"
        "return 'autofill error: '+(e&&e.message?e.message:String(e));}})()"
    )


def main() -> int:
    parser = argparse.ArgumentParser(description="Fill web forms from a local autofill profile")
    parser.add_argument("--profile", help="profile name to use (default: the `default` profile in profiles.toml, "
                                           "or a [sites.*] entry matching the current host)")
    parser.add_argument("--choose", action="store_true", help="pick the profile via a rofi menu")
    parser.add_argument(
        "--overwrite", action=argparse.BooleanOptionalAction, default=None,
        help="also replace fields that already have a value (overrides any [sites.*] `overwrite` setting; "
             "default: only fill empty fields, or whatever the matching [sites.*] entry says)",
    )
    parser.add_argument("--undo", action="store_true",
                         help="undo the fields the last autofill run changed on this page (does not need "
                              "profiles.toml at all)")
    parser.add_argument("--misses", action="store_true",
                         help="write a report of fields autofill could not classify (see misses.jsonl) "
                              "and open it in a new tab")
    args = parser.parse_args()

    if args.undo:
        # Deliberately only ONE jseval call here -- see build_undo_invocation().
        fifo_send(f"jseval --world jseval {build_undo_invocation()}")
        return 0

    if args.misses:
        return handle_misses_report()

    if ensure_profiles_file():
        message_info(
            f"autofill: created template profiles.toml at {PROFILES_PATH} "
            "- edit it with your real data before using autofill"
        )
        return 0

    try:
        data = load_profiles()
    except tomllib.TOMLDecodeError as e:
        message_error(f"autofill: could not parse {PROFILES_PATH}: {e}")
        return 1

    profiles = data.get("profiles", {})
    if not profiles:
        message_error(f"autofill: no [profiles.*] sections found in {PROFILES_PATH}")
        return 1

    host = resolve_host()
    site = resolve_site_settings(host, data.get("sites", {}) or {})

    if args.choose:
        chosen = choose_profile_with_rofi(sorted(profiles.keys()))
        if chosen is None:
            return 0  # cancelled, or rofi missing (already reported)
        profile_name = chosen
    elif args.profile:
        profile_name = args.profile
    elif site.get("profile"):
        profile_name = site["profile"]
    else:
        profile_name = data.get("default")
        if not profile_name:
            message_error("autofill: no --profile given and no `default` set in profiles.toml")
            return 1

    if profile_name not in profiles:
        message_error(f"autofill: unknown profile '{profile_name}' (have: {', '.join(sorted(profiles.keys()))})")
        return 1

    # CLI flags always override [sites.*] settings; skip has no CLI
    # equivalent (site-only, per the task spec).
    if args.overwrite is not None:
        overwrite = args.overwrite
    elif site.get("overwrite") is not None:
        overwrite = bool(site["overwrite"])
    else:
        overwrite = False
    skip_kinds = [str(k) for k in (site.get("skip") or [])]

    profile = {k: json_safe(v) for k, v in profiles[profile_name].items()}
    opts = {
        "overwrite": overwrite,
        "profileName": profile_name,
        "strictVisibility": True,
        "skipKinds": skip_kinds,
    }

    invocation = build_invocation(profile, opts)

    # jseval's js-code argument is parsed with maxsplit=0/no_cmd_split=True:
    # it is the raw rest-of-line, NOT run through qutebrowser's shell-like
    # quote parsing (that's what lets arbitrary JS/paths through unmangled).
    # So JS_SOURCE_PATH is given here unquoted -- it never contains spaces or
    # shell metacharacters. Both calls target the isolated "jseval" world (see
    # module docstring): the first loads the non-sensitive classifier library
    # fresh from disk, the second (profile-bearing) line is never written to
    # disk anywhere.
    fifo_send(
        # --quiet here: this call's only job is to (re)define QuteAutofill;
        # its JS completion value (undefined) is not useful to show, only the
        # second call's return value (the summary) should reach the user.
        f"jseval --file --quiet --world jseval {JS_SOURCE_PATH}",
        f"jseval --world jseval {invocation}",
    )

    spawn_miss_classifier(host)  # best-effort, detached, never blocks/errors the fill above
    return 0


if __name__ == "__main__":
    sys.exit(main())
