def _set_login(self, url, login, password, submit_url=None, group=None, uuid=None):
    """set-login action, attached onto a connected qkpxc.KeepassXC instance.

    Not implemented by qute-keepassxc (it's a read-only client), so this is
    bound as an extra method at runtime instead of editing that file.

    Wire format confirmed two ways:
      1. Empirically, against a real, isolated KeePassXC 2.7.12 instance
         (see the test suite / report for the exact request/response
         observed there - that pass did not exercise `uuid` update-in-place,
         which duplicated entries instead of updating them).
      2. Against the official keepassxc-browser browser-extension source
         (~/.var/app/com.google.Chrome/config/google-chrome/Default/
         Extensions/oboonakemofpalcgghocfoadofidjkkk/<version>/background/
         keepass.js, function `keepass.updateCredentials`): it sends the
         exact same fields (action/id/login/password/url/submitUrl[/group/
         groupUuid]) and additionally sets `messageData.uuid = entryId`
         *only* when updating an existing entry (entryId truthy); uuid is
         omitted entirely to create a new entry - which is exactly what
         `uuid=None` (skip the key) below does. That function also confirms
         the response's `error` field is `'success'` (or, on older KeePassXC,
         `''`) on success for this specific action.
    """
    msg = dict(
        action="set-login",
        url=url,
        submitUrl=submit_url or url,
        id=self.id,
        login=login,
        password=password,
        key=base64.b64encode(self.id_key.public_key.encode()).decode("utf-8"),
    )
    if group:
        msg["group"] = group
    if uuid:
        msg["uuid"] = uuid
    self.send_msg(msg)
    return self.recv_msg()


# ---------------------------------------------------------------------------
# Avoiding duplicate entries: look up existing entries for this URL/login
# ---------------------------------------------------------------------------

def find_matching_entries(kp, url, login, alias_term=None):
    """Entries found via kpxc_lookup's cascade whose login matches (case-insensitive).

    Uses the same domain-widening cascade as keepassxc-login (kl.lookup)
    rather than a single exact get-logins(url) call, so a signup/change
    -password form on a page whose entry actually lives at the origin, a
    parent domain, or a remembered alias is still recognised as a
    duplicate instead of silently creating a second entry there.

    Note: KeePassXC only returns entries it is willing to expose to this
    connection via get-logins; an entry this same script created a moment
    ago via set-login is not guaranteed to come back here (observed
    empirically against a real instance) - so this lookup can under-report
    matches. When it does, the practical effect is just a duplicate entry
    (the pre-existing behaviour), not a wrong password ending up saved.
    """
    try:
        _matched_url, entries = kl.lookup(kp, url, alias_term)
    except Exception:
        # get-logins failing (e.g. KeepassError, socket hiccup) must not
        # abort the save flow - fall back to "no known matches" (create).
        entries = []
    return [e for e in (entries or []) if (e.get("login") or "").lower() == login.lower()]


def prompt_update_or_create(host, login):
    """rofi: single existing match found - update it, or create a new entry?

    Pre-highlighted/first option is "update" (rofi highlights the first
    list entry by default), matching the requested default. Escape cancels.
    """
    options = [f"update existing entry for {login}", "create new entry"]
    try:
        proc = subprocess.run(
            ["rofi", "-dmenu", "-p", f"keepassxc-newpass: entry exists for {host}"],
            input="\n".join(options) + "\n", capture_output=True, text=True, check=False,
        )
    except FileNotFoundError:
        message_error("keepassxc-newpass: rofi is not installed - defaulting to update")
        return "update"
    if proc.returncode != 0:
        return None  # Escape / cancelled
    choice = proc.stdout.strip()
    if choice == options[0]:
        return "update"
    if choice == options[1]:
        return "create"
    return None  # unrecognised/custom text typed - treat as cancel, never guess


def prompt_pick_entry(host, login, matches):
    """rofi: multiple existing matches - pick one to update, or create new.

    Returns a uuid to update, '__create__', or None (cancel/unrecognised).
    """
    create_label = "create new entry"
    label_to_uuid = {}
    lines = []
    for i, e in enumerate(matches):
        uuid = e.get("uuid") or ""
        label = f"update: {e.get('name') or e.get('login') or ('entry ' + str(i + 1))} [{uuid[:8]}]"
        label_to_uuid[label] = uuid
        lines.append(label)
    lines.append(create_label)
    try:
        proc = subprocess.run(
            ["rofi", "-dmenu", "-p", f"keepassxc-newpass: {len(matches)} entries for {login} on {host}"],
            input="\n".join(lines) + "\n", capture_output=True, text=True, check=False,
        )
    except FileNotFoundError:
        message_error("keepassxc-newpass: rofi is not installed")
        return None  # ambiguous - never guess which entry to overwrite
    if proc.returncode != 0:
        return None
    choice = proc.stdout.strip()
    if choice == create_label:
        return "__create__"
    return label_to_uuid.get(choice) or None


# ---------------------------------------------------------------------------
# Parsing password-field constraints out of $QUTE_HTML
# ---------------------------------------------------------------------------

class _InputCollector(HTMLParser):
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.inputs = []

    def handle_starttag(self, tag, attrs):
        if tag.lower() == "input":
            d = {k.lower(): (v if v is not None else "") for k, v in attrs}
            self.inputs.append(d)


def parse_password_fields(html_text: str) -> dict:
    """Extract new-password field constraints from a page's HTML dump.

    $QUTE_HTML is a live DOM serialization (QtWebEngine's page().toHtml(),
    called by qutebrowser before spawning any userscript - see
    qutebrowser/commands/userscripts.py's store_html()/run_async() and
    webenginetab.py's dump_async()), not the original network response, so
    this reflects JS-rendered forms too.
    """
    parser = _InputCollector()
    try:
        parser.feed(html_text or "")
    except Exception:
        pass

    inputs = parser.inputs

    def is_password(i):
        return i.get("type", "text").lower() == "password"

    def tokens(i, attr):
        return (i.get(attr, "") or "").lower().split()

    pw_fields = [i for i in inputs if is_password(i)]
    current_pw = [i for i in pw_fields if "current-password" in tokens(i, "autocomplete")]
    new_pw = [i for i in pw_fields if i not in current_pw]
    explicit_new = [i for i in new_pw if "new-password" in tokens(i, "autocomplete")]
    target = (explicit_new or new_pw or pw_fields or [{}])[0]

    def to_int(v):
        try:
            return int(v)
        except (TypeError, ValueError):
            return None

    return {
        "minlength": to_int(target.get("minlength")),
        "maxlength": to_int(target.get("maxlength")),
        "pattern": target.get("pattern") or None,
        "passwordrules": target.get("passwordrules") or target.get("data-passwordrules") or None,
        "has_new_password_field": bool(new_pw),
        "has_current_password_field": bool(current_pw),
        "has_confirm_pair": len(new_pw) >= 2,
        "password_field_count": len(pw_fields),
    }


# ---------------------------------------------------------------------------
# Password generation
# ---------------------------------------------------------------------------

ALL_CLASSES = frozenset({"lower", "upper", "digit", "special"})
_DROP_ORDER = ["special", "digit", "upper"]  # order in which classes are dropped as a last resort


def clamp_length(requested: int, minlength, maxlength) -> int:
    length = requested
    if maxlength is not None and maxlength > 0:
        length = min(length, maxlength)
    if minlength is not None and minlength > 0:
        length = max(length, minlength)
    if maxlength is not None and maxlength > 0:
        length = min(length, maxlength)  # maxlength wins if it conflicts with minlength
    return max(length, 1)


def parse_password_rules(rules_str):
    """Parse (a practical subset of) Apple's `passwordrules` attribute format.

    e.g. "minlength: 8; maxlength: 20; required: upper, lower, digit, special;"
    Unsupported directives (allowed, max-consecutive, ...) are ignored.
    """
    result = {"minlength": None, "maxlength": None, "required": None}
    if not rules_str:
        return result
    name_map = {
        "upper": "upper", "uppercase": "upper",
        "lower": "lower", "lowercase": "lower",
        "digit": "digit", "digits": "digit", "number": "digit", "numeric": "digit",
        "special": "special", "symbol": "special", "special-characters": "special",
    }
    for directive in rules_str.split(";"):
        directive = directive.strip()
        if not directive or ":" not in directive:
            continue
        key, _, value = directive.partition(":")
        key = key.strip().lower()
        value = value.strip()
        if key == "minlength":
            try:
                result["minlength"] = int(value)
            except ValueError:
                pass
        elif key == "maxlength":
            try:
                result["maxlength"] = int(value)
            except ValueError:
                pass
        elif key == "required":
            req = set()
            for part in value.split(","):
                part = part.strip().lower()
                if part in name_map:
                    req.add(name_map[part])
            if req:
                result["required"] = req
    return result


def _class_fallback_sequence(required):
    """[required, required-minus-special, ...-digit, ...-upper], never empty."""
    current = set(required) or set(ALL_CLASSES)
    seq = [frozenset(current)]
    for cls in _DROP_ORDER:
        if cls in current and len(current) > 1:
            current = current - {cls}
            seq.append(frozenset(current))
    return seq


def build_keepassxc_cli_args(length, classes, exclude_similar=True, extra_exclude=""):
    """Build the argv tail (after the 'keepassxc-cli' executable) for `generate`."""
    args = ["generate", "-q", "-L", str(length)]
    if "lower" in classes:
        args.append("-l")
    if "upper" in classes:
        args.append("-U")
    if "digit" in classes:
        args.append("-n")
    if "special" in classes:
        args.append("-s")
    if len(classes) > 1:
        args.append("--every-group")
    exclude = extra_exclude or ""
    if "special" in classes:
        exclude += _EXCLUDED_SYMBOLS
    if exclude:
        seen = set()
        exclude = "".join(c for c in exclude if not (c in seen or seen.add(c)))
        args += ["-x", exclude]
    if exclude_similar:
        args.append("--exclude-similar")
    return args


def run_keepassxc_cli_generate(argv_tail, cli_path="keepassxc-cli", timeout=5):
    """Run `<cli_path> <argv_tail>`, return the generated password or None on any failure.

    Never logs the password. Returns None (not an exception) for "this
    combination of length/classes isn't achievable" (keepassxc-cli exits 1
    with 'Invalid password generator after applying all options' e.g. for
    length below what 4 character classes need), a missing binary, or a
    timeout - the caller is expected to try a smaller class set instead.
    """
    try:
        proc = subprocess.run(
            [cli_path] + argv_tail, capture_output=True, text=True, timeout=timeout,
        )
    except (FileNotFoundError, OSError, subprocess.TimeoutExpired):
        return None
    if proc.returncode != 0:
        return None
    pw = proc.stdout.rstrip("\r\n")
    return pw or None


def _secrets_charset(cls, exclude_similar):
    base = {
        "lower": string.ascii_lowercase,
        "upper": string.ascii_uppercase,
        "digit": string.digits,
        "special": CONSERVATIVE_SYMBOLS,
    }[cls]
    if exclude_similar and cls != "special":
        base = "".join(c for c in base if c not in AMBIGUOUS_CHARS)
    return base


def generate_with_python_secrets(length, classes, exclude_similar=True):
    classes = sorted(classes)  # stable order, doesn't affect security (still secrets.choice/shuffled)
    pools = {c: _secrets_charset(c, exclude_similar) for c in classes}
    all_chars = "".join(pools.values())
    if not all_chars:
        raise ValueError("no character classes selected")
    required_chars = [secrets.choice(pools[c]) for c in classes]
    if len(required_chars) > length:
        required_chars = required_chars[:length]
    rest = [secrets.choice(all_chars) for _ in range(max(length - len(required_chars), 0))]
    pwd_chars = required_chars + rest
    for i in range(len(pwd_chars) - 1, 0, -1):
        j = secrets.randbelow(i + 1)
        pwd_chars[i], pwd_chars[j] = pwd_chars[j], pwd_chars[i]
    return "".join(pwd_chars)


def generate_password(
    *,
    requested_length=DEFAULT_LENGTH,
    minlength=None,
    maxlength=None,
    pattern=None,
    passwordrules=None,
    cli_path="keepassxc-cli",
    max_attempts=DEFAULT_MAX_ATTEMPTS,
    exclude_similar=True,
):
    """Generate a password honouring field constraints.

    Prefers `keepassxc-cli generate`; falls back to Python `secrets` only if
    the CLI is missing or fails outright (never as the default path).
    Returns (password, meta) where meta has at least 'source' and 'length'.
    """
    rules = parse_password_rules(passwordrules)
    eff_min = minlength
    eff_max = maxlength
    if rules["minlength"] is not None:
        eff_min = max(eff_min or 0, rules["minlength"])
    if rules["maxlength"] is not None:
        eff_max = rules["maxlength"] if eff_max is None else min(eff_max, rules["maxlength"])
    length = clamp_length(requested_length, eff_min, eff_max)

    base_required = rules["required"] or set(ALL_CLASSES)
    class_sequence = _class_fallback_sequence(base_required)

    cli_available = shutil.which(cli_path) is not None

    if cli_available:
        for classes in class_sequence:
            attempts = max_attempts if pattern else 1
            for _ in range(attempts):
                argv = build_keepassxc_cli_args(length, classes, exclude_similar=exclude_similar)
                pw = run_keepassxc_cli_generate(argv, cli_path)
                if pw is None:
                    break  # this class combo isn't achievable at this length; try fewer classes
                if not pattern or re.fullmatch(pattern, pw):
                    return pw, {"source": "keepassxc-cli", "classes": sorted(classes), "length": length}

    # Fallback: Python `secrets` (cli missing, or cli failed / never matched pattern)
    fallback_suffix = "" if cli_available else " (keepassxc-cli unavailable)"
    for classes in class_sequence:
        attempts = max_attempts if pattern else 1
        for _ in range(attempts):
            pw = generate_with_python_secrets(length, classes, exclude_similar=exclude_similar)
            if not pattern or re.fullmatch(pattern, pw):
                return pw, {
                    "source": "python-secrets" + fallback_suffix,
                    "classes": sorted(classes),
                    "length": length,
                }

    # Last resort: alnum-only, accepted even if `pattern` still doesn't match.
    alnum_classes = {c for c in ("lower", "upper", "digit") if c in base_required} or {"lower", "upper", "digit"}
    pw = generate_with_python_secrets(length, alnum_classes, exclude_similar=exclude_similar)
    return pw, {
        "source": "python-secrets-fallback-alnum" + fallback_suffix,
        "classes": sorted(alnum_classes),
        "length": length,
        "warning": "pattern not confirmed after bounded attempts" if pattern else None,
    }


