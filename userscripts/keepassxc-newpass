DEFAULT_LENGTH = 14
# Conservative symbol whitelist: common on password-policy allow-lists and
# safe to embed in JSON/JS without any escaping surprises. keepassxc-cli's
# own -s/--special charset is effectively all of string.punctuation; when we
# ask it for symbols we exclude everything outside this set with -x so the
# generated password stays inside this conservative set even when the CLI
# does the generating.
CONSERVATIVE_SYMBOLS = "!@#$%^&*-_=+.,?~"
_EXCLUDED_SYMBOLS = "".join(sorted(set(string.punctuation) - set(CONSERVATIVE_SYMBOLS)))

# Characters that look alike in many fonts (matches keepassxc-cli's own
# --exclude-similar intent) - used by the Python `secrets` fallback so its
# output is comparable to keepassxc-cli's with --exclude-similar.
AMBIGUOUS_CHARS = set("il1IlLo0O")

DEFAULT_MAX_ATTEMPTS = 40  # per character-class level, only spent when a pattern must be matched
DEFAULT_SAVE_TIMEOUT = 60.0  # seconds to wait for KeePassXC to confirm set-login (it may show a dialog)


