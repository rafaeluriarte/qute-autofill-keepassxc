# Filling the page (isolated jseval world, native setter + bubbling events)
# ---------------------------------------------------------------------------

def build_fill_js(login: str, password: str) -> str:
    template = """
        (function () {
            function isVisible(el) {
                if (!el || !el.isConnected) return false;
                var win = el.ownerDocument.defaultView;
                var cs = win.getComputedStyle(el);
                if (cs.visibility === "hidden" || cs.display === "none" || cs.opacity === "0") return false;
                var r = el.getBoundingClientRect();
                return r.width > 0 && r.height > 0;
            }
            function tokens(el) {
                return (el.getAttribute("autocomplete") || "").toLowerCase().split(/\\s+/);
            }
            function nativeSetter(el) {
                var proto = el.tagName === "SELECT" ? window.HTMLSelectElement.prototype
                    : el.tagName === "TEXTAREA" ? window.HTMLTextAreaElement.prototype
                    : window.HTMLInputElement.prototype;
                var d = Object.getOwnPropertyDescriptor(proto, "value");
                return d && d.set;
            }
            function setVal(el, v) {
                var setter = nativeSetter(el);
                if (setter) setter.call(el, v); else el.value = v;
                el.dispatchEvent(new Event("input", { bubbles: true }));
                el.dispatchEvent(new Event("change", { bubbles: true }));
            }
            var PASSWORD = %s;
            var LOGIN = %s;
            var inputs = Array.prototype.slice.call(document.querySelectorAll("input"));
            var pwFields = inputs.filter(function (el) { return el.type === "password" && isVisible(el); });
            var currentPw, newPw;
            if (pwFields.some(function (el) { return tokens(el).indexOf("current-password") !== -1; })) {
                currentPw = pwFields.filter(function (el) { return tokens(el).indexOf("current-password") !== -1; });
                newPw = pwFields.filter(function (el) { return currentPw.indexOf(el) === -1; });
            } else if (pwFields.length === 3) {
                currentPw = [pwFields[0]];
                newPw = pwFields.slice(1);
            } else {
                currentPw = [];
                newPw = pwFields;
            }
            if (newPw.length === 0) {
                return "keepassxc-newpass: no new-password field found, nothing filled";
            }
            newPw.forEach(function (el) { setVal(el, PASSWORD); });
            function isLoginType(el) {
                return isVisible(el) && (el.type === "email" || el.type === "text" || el.type === "");
            }
            var loginField = inputs.find(function (el) {
                var t = tokens(el);
                return isLoginType(el) && (t.indexOf("username") !== -1 || t.indexOf("email") !== -1);
            });
            if (!loginField) {
                var idx = inputs.indexOf(newPw[0]);
                for (var i = idx - 1; i >= 0 && !loginField; i--) { if (isLoginType(inputs[i])) loginField = inputs[i]; }
                for (var j = idx + 1; j < inputs.length && !loginField; j++) { if (isLoginType(inputs[j])) loginField = inputs[j]; }
            }
            if (loginField) setVal(loginField, LOGIN);
            return "keepassxc-newpass: filled " + newPw.length + " password field(s)" + (loginField ? " and the login field" : "");
        })()
    """
    return " ".join(template.splitlines()) % (_dump_one_line(password), _dump_one_line(login))


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def parse_args(argv=None):
    parser = argparse.ArgumentParser(description="Generate, save to KeePassXC, then fill a new password")
    parser.add_argument("url", nargs="?", default=os.environ.get("QUTE_URL"))
    parser.add_argument("--length", type=int, default=DEFAULT_LENGTH,
                         help=f"requested password length, clamped to the field's minlength/maxlength (default: {DEFAULT_LENGTH})")
    parser.add_argument("--group", default=None, help="KeePassXC group to save the entry into")
    parser.add_argument("--socket", "-s",
                         default=os.environ.get("QUTE_KEEPASSXC_SOCKET",
                                                 "/run/user/{}/org.keepassxc.KeePassXC.BrowserServer".format(os.getuid())),
                         help="path to the KeePassXC browser-protocol socket")
    parser.add_argument("--key", "-k", default="alice@example.com",
                         help="GPG key the association key is encrypted with (pass the SAME key as the `pw` binding to reuse its association)")
    parser.add_argument("--insecure", action="store_true", help="do not GPG-encrypt the association key file")
    parser.add_argument("--cli-path", default=os.environ.get("QUTE_KEEPASSXC_CLI", "keepassxc-cli"),
                         help="keepassxc-cli executable used for password generation")
    parser.add_argument("--exclude-similar", dest="exclude_similar", action=argparse.BooleanOptionalAction, default=True)
    parser.add_argument("--save-timeout", type=float, default=DEFAULT_SAVE_TIMEOUT,
                         help="seconds to wait for KeePassXC to confirm the save (it may show a confirmation dialog)")
    parser.add_argument("--dry-run", action="store_true",
                         help="print what would happen (constraints, login source, generated length) without saving or filling anything")
    return parser.parse_args(argv)


def main(argv=None):
    args = parse_args(argv)

    if "QUTE_FIFO" not in os.environ and not args.dry_run:
        print(f"No QUTE_FIFO found - {sys.argv[0]} must be run as a qutebrowser userscript "
              "(or with --dry-run for manual testing)", file=sys.stderr)
        return 1

    if not args.url:
        message_error("keepassxc-newpass: missing URL")
        return 1

    html_path = os.environ.get("QUTE_HTML")
    html_text = ""
    if html_path and os.path.exists(html_path):
        with open(html_path, encoding="utf-8", errors="replace") as f:
            html_text = f.read()

    constraints = parse_password_fields(html_text)
    if not constraints["has_new_password_field"]:
        message_error("keepassxc-newpass: no new-password field found on this page")
        return 1

    pw, meta = generate_password(
        requested_length=args.length,
        minlength=constraints["minlength"],
        maxlength=constraints["maxlength"],
        pattern=constraints["pattern"],
        passwordrules=constraints["passwordrules"],
        cli_path=args.cli_path,
        exclude_similar=args.exclude_similar,
    )

    host = urlparse(args.url).netloc or args.url
    host_only = urlparse(args.url).hostname or host

    if args.dry_run:
        print(f"[dry-run] url: {args.url}")
        print(f"[dry-run] host: {host}")
        print(f"[dry-run] minlength={constraints['minlength']} maxlength={constraints['maxlength']}")
        print(f"[dry-run] pattern={constraints['pattern']!r}")
        print(f"[dry-run] passwordrules={constraints['passwordrules']!r}")
        print(f"[dry-run] password_field_count={constraints['password_field_count']} "
              f"has_current_password_field={constraints['has_current_password_field']} "
              f"has_confirm_pair={constraints['has_confirm_pair']}")
        print(f"[dry-run] generated password length={meta['length']} source={meta['source']} classes={meta.get('classes')}")
        if meta.get("warning"):
            print(f"[dry-run] warning: {meta['warning']}")
        print("[dry-run] login: would come from profiles.toml's default profile / a rofi prompt (value not shown)")
        print("[dry-run] nothing was saved to KeePassXC and nothing was filled")
        return 0

    default_login = load_login_profile_default()
    login = prompt_login(host, default_login)
    if not login:
        message_info("keepassxc-newpass: cancelled")
        return 0

    qkpxc = load_qute_keepassxc()
    ns = SimpleNamespace(key=(None if args.insecure else args.key), insecure=args.insecure, socket=args.socket)
    try:
        kp = qkpxc.connect_to_keepassxc(ns)
    except qkpxc.KeepassError as e:
        message_error(f"keepassxc-newpass: {e}")
        return 1
    if not kp:
        # connect_to_keepassxc() already reported the specific reason via message-error
        return 1
    kp.set_login = types.MethodType(_set_login, kp)

    # Avoid duplicate entries: look up existing entries for this URL whose
    # login matches, and decide whether to update one in place (uuid) or
    # create a new entry, per the policy in the module docstring's "Avoiding
    # duplicate entries" section. Uses the same domain-widening cascade (and
    # any remembered alias for this host) as keepassxc-login, so an entry
    # that actually lives at the origin/a parent domain/an aliased site is
    # still found instead of creating a duplicate.
    target_uuid = None
    alias_term = kl.get_alias(host_only) if host_only else None
    matches = find_matching_entries(kp, args.url, login, alias_term=alias_term)
    if len(matches) == 1:
        if constraints["has_current_password_field"]:
            target_uuid = matches[0].get("uuid")  # change-password form: update by default
        else:
            choice = prompt_update_or_create(host, login)
            if choice is None:
                message_info("keepassxc-newpass: cancelled")
                return 0
            if choice == "update":
                target_uuid = matches[0].get("uuid")
    elif len(matches) > 1:
        chosen = prompt_pick_entry(host, login, matches)
        if chosen is None:
            message_info("keepassxc-newpass: cancelled")
            return 0
        if chosen != "__create__":
            target_uuid = chosen

    # Save with url=origin (scheme://host[:port]/) rather than the full page
    # URL: KeePassXC's own get-logins matching only ever looks at
    # scheme+host+port (see kpxc_lookup.py's module docstring), so a
    # path-specific saved URL buys nothing and only makes this entry harder
    # for the (equally path-insensitive) lookup cascade to associate with
    # other pages on the same site later. submitUrl keeps the exact page
    # URL, matching what qute-keepassxc's own keepass.updateCredentials
    # reference sends it as.
    parsed_page_url = urlparse(args.url)
    port_part = f":{parsed_page_url.port}" if parsed_page_url.port else ""
    save_url = f"{parsed_page_url.scheme}://{parsed_page_url.hostname}{port_part}/"

    old_timeout = kp.sock.gettimeout()
    kp.sock.settimeout(args.save_timeout)
    try:
        resp = kp.set_login(
            url=save_url, login=login, password=pw, submit_url=args.url, group=args.group, uuid=target_uuid,
        )
    except socket_module.timeout:
        message_error(
            f"keepassxc-newpass: KeePassXC did not confirm the save within {args.save_timeout:.0f}s "
            "(a confirmation dialog may be waiting) - nothing was filled"
        )
        return 1
    except qkpxc.KeepassError as e:
        message_error(f"keepassxc-newpass: save failed: {e}")
        return 1
    finally:
        try:
            kp.sock.settimeout(old_timeout)
        except OSError:
            pass

    # KeePassXC's set-login reply puts 'error': 'success' in the *decrypted*
    # payload even on success (verified empirically) - only 'success': 'true'
    # is meaningful here; qkpxc.recv_msg() only raises on the outer,
    # unencrypted 'error' field (protocol/association-level errors).
    if resp.get("success") != "true":
        message_error(f"keepassxc-newpass: save failed: {resp}")
        return 1

    js = build_fill_js(login, pw)
    action_verb = "updated" if target_uuid else "saved new"
    fifo_send(
        f"jseval --quiet --world jseval {js}",
        "message-info " + qb_quote(f"keepassxc: {action_verb} password and filled (login {login})"),
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
