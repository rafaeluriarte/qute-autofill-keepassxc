def load_login_profile_default():
    """Read ~/.config/qutebrowser/autofill/profiles.toml's default profile's
    username (else email). Never prints/logs the value; returns None quietly
    on any error (missing file, bad TOML, no default, ...).
    """
    config_dir = Path(os.environ.get("QUTE_CONFIG_DIR") or os.path.expanduser("~/.config/qutebrowser"))
    profiles_path = config_dir / "autofill" / "profiles.toml"
    if not profiles_path.exists():
        return None
    try:
        with open(profiles_path, "rb") as f:
            data = tomllib.load(f)
    except (OSError, tomllib.TOMLDecodeError):
        return None
    profiles = data.get("profiles", {})
    name = data.get("default")
    profile = profiles.get(name, {}) if name else {}
    return profile.get("username") or profile.get("email") or None


def prompt_login(host, default_login):
    """rofi -dmenu prompt, prefilled/selectable with default_login; Escape cancels.

    Returns the chosen/typed login, or None if the user cancelled (or typed
    nothing and there was no default).
    """
    args = ["rofi", "-dmenu", "-p", f"login for {host}"]
    stdin_text = ""
    if default_login:
        args += ["-filter", default_login]
        stdin_text = default_login + "\n"
    try:
        proc = subprocess.run(args, input=stdin_text, capture_output=True, text=True, check=False)
    except FileNotFoundError:
        message_error("keepassxc-newpass: rofi is not installed")
        return default_login or None
    if proc.returncode != 0:
        return None  # Escape / cancelled
    value = proc.stdout.strip()
    return value or default_login or None


