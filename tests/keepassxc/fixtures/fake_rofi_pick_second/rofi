#!/usr/bin/env python3
"""Fake `rofi`: for the login prompt (-filter given) echoes the default
login as usual; for a pick-entry prompt with 2+ lines, picks the SECOND
line (index 1) - proving a specific, non-default entry can be chosen.
"""
import sys

if "-filter" in sys.argv:
    print(sys.argv[sys.argv.index("-filter") + 1])
    sys.exit(0)

lines = [line.rstrip("\n") for line in sys.stdin]
print(lines[1] if len(lines) > 1 else (lines[0] if lines else ""))
sys.exit(0)
